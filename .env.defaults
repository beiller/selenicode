# Default configuration for agent1
# Copy this file to .env and modify as needed

# Llama server base URL - full URL with scheme + host + port (default: http://127.0.0.1:8080)
LLAMA_BASE_URL=http://127.0.0.1:8080

# API key for the model server (optional; sent as a Bearer token when set)
# LLAMA_API_KEY=

# Current model name (optional, used for initial load)
CURRENT_MODEL=Qwen3.8-27B-Q4_K_M

# Llama server binary path
LLAMA_SERVER_PATH=./bin/ubuntu_24.04/llama-server

# Llama models directory
LLAMA_MODELS_DIR=./models

MODEL_DOWNLOAD_REPO_ID="bartowski/Qwen3.8-27B-GGUF"
MODEL_DOWNLOAD_FILENAME="Qwen3.8-27B-Q4_K_M.gguf"

# Discord Bot Token
DISCORD_TOKEN="discord token here"

# Load all layers on to the GPU. Set to 0 for CPU only
GPU_LAYERS=999

# Context size, should work on 16 GB card at 16384
CTX_SIZE=16384

# Number of newest user turns kept verbatim after compaction
COMPACTION_TAIL_TURNS=6
# Compaction auto-trigger threshold as a percentage of context size
COMPACTION_TRIGGER_PCT=80
# Compaction shrink-to target as a percentage of context size 
COMPACTION_TARGET_PCT=30
